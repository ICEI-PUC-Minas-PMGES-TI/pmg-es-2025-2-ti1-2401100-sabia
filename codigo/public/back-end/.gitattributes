# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Configuration files
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation
*.md text eol=lf
docs/* text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
